# Copy to `.env` and fill in. Load locally with:
#   python -m earnings_notifier --env-file .env --dry-run
# In GitHub Actions these are provided as repository secrets/variables instead.

# --- SMTP (required to actually send) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# For Gmail, use an App Password (not your normal password):
#   https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true        # STARTTLS on port 587
SMTP_USE_SSL=false       # set true (and SMTP_PORT=465) for implicit TLS

# --- Addresses ---
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com,teammate@example.com   # comma-separated

# --- Notification window (optional) ---
LEAD_DAYS=7              # notify for earnings within this many days (the "week")
MIN_DAYS=0               # earliest days-out to include (0 = today onward)

# --- Once-only de-duplication (optional) ---
# Each earnings is emailed only once; notified (ticker, date) pairs are stored
# here between runs. In GitHub Actions this path is persisted via actions/cache.
STATE_FILE=state/notified.json
# USE_STATE=false        # disable de-dup: report the whole window every run
# SEND_EMPTY=true        # email even when nothing new is due

# --- Watchlist (optional) ---
# Extra tickers to track ON TOP OF the S&P 500 (e.g. names outside the index).
# EXTRA_TICKERS=NBIS,ASML,SHOP

# --- Testing (optional) ---
# TICKER_LIMIT=25        # only look up the first N tickers
# DRY_RUN=true           # render + print instead of sending

# --- Charles Schwab market data (optional, analyzer only) ---
# Real-time quotes/chains for the trade sheet; Yahoo remains the fallback.
# Register an app at https://developer.schwab.com, then run
#   python scripts/schwab_auth.py --set-secret
# weekly (Schwab refresh tokens expire every 7 days).
# SCHWAB_APP_KEY=your-app-key
# SCHWAB_APP_SECRET=your-app-secret
# SCHWAB_TOKEN={"access_token":"...","refresh_token":"...","expires_at":0}
# SCHWAB_TOKEN_FILE=schwab_token.json   # alternative to SCHWAB_TOKEN
